{
  "name": "ncd",
  "version": "1.3.39",
  "description": "NCD — система управления целями",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "dev": "node bin/web-dev.cjs",
    "web": "node bin/web-dev.cjs",
    "tunnel": "./tunnel.sh",
    "deploy": "bash ./deploy-update.sh",
    "deploy:site": "bash ./deploy.sh",
    "build": "electron-builder",
    "build:avatar": "esbuild src/avatar-video.js --bundle --minify --format=iife --outfile=avatar.js --target=es2020",
    "build:storage": "esbuild src/profile-storage.js --bundle --minify --format=iife --outfile=profile-storage.js --target=es2020",
    "build:web": "npm run build:avatar && npm run build:storage && node bin/prepare-web.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "node --test test/*.test.cjs",
    "test:social:db": "node test/social-nickname.postgres.cjs",
    "test:player-tags:db": "node test/player-tags.postgres.cjs",
    "mobile:dev": "node bin/mobile-dev.cjs",
    "android:sync": "npm run build:web && cap sync android && node bin/prepare-android-assets.cjs",
    "android:open": "npm run android:sync && cap open android",
    "android:build": "bash bin/build-phone-update.sh",
    "build:icons": "python3 bin/generate-icons.py",
    "ios:sync": "npm run build:web && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "ios:build": "node bin/build-ios.cjs",
    "preview:web": "node bin/preview-web.cjs"
  },
  "author": "NCD",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.14.0",
    "wrangler": "^4.148.0"
  },
  "build": {
    "appId": "com.goaltracker.pro",
    "productName": "NCD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "profile-store.js",
      "profile-storage.js",
      "server.js",
      "index.html",
      "styles.css",
      "ios-layout.js",
      "app.js",
      "workspace.js",
      "case.js",
      "learning.js",
      "goals.js",
      "achievements.js",
      "ui-select.js",
      "ota-sync.js",
      "finance.js",
      "health.js",
      "health-3d.js",
      "gamification.js",
      "notifications.js",
      "auth_sync.js",
      "avatar.js",
      "vendor/three/**/*",
      "assets/**/*",
      "manifest.json",
      "sw.js",
      "icon.png",
      "icon-48.png",
      "icon-192.png",
      "icon-512.png",
      "icon-192-maskable.png",
      "icon-512-maskable.png",
      "icon.svg",
      "sync.js",
      "vendor/supabase/**/*",
      "supabase-config.js",
      "icon.ico",
      "icon.icns"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Utility"
    },
    "nsis": {
      "shortcutName": "NCD"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-updater": "^8.52.1",
    "three": "^0.186.1",
    "@capacitor/ios": "8.5.3"
  }
}
